# PostgreSQL database/user must match docker/docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=f1_db
POSTGRES_USER=f1_user
POSTGRES_PASSWORD=replace_with_your_database_password

# Scripts running directly on Windows
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_LAP=f1_lap_data
OPENF1_BASE_URL=https://api.openf1.org/v1
CASSANDRA_HOST=localhost

# Airflow
AIRFLOW_ADMIN_PASSWORD=replace_with_your_airflow_password

# Docker overrides hostnames and the Spark checkpoint path.
# For local Spark runs, set SPARK_CHECKPOINT_DIR to a local folder.